{
    "$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "files": {
        "ignoreUnknown": true,
        "includes": [
            "**",
            "!dist",
            "!docs",
            "!.claude",
            "!assets/stories/red-riding-hood/animation",
            "!.rnstorybook/storybook.requires.ts"
        ]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 120
    },
    "javascript": {
        "formatter": {
            "arrowParentheses": "always",
            "bracketSpacing": true,
            "bracketSameLine": false,
            "jsxQuoteStyle": "double",
            "quoteProperties": "asNeeded",
            "semicolons": "always",
            "quoteStyle": "double",
            "trailingCommas": "es5"
        }
    },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended",
            "a11y": {
                "noSvgWithoutTitle": "off"
            },
            "complexity": {
                "noImportantStyles": "error"
            },
            "suspicious": {
                "noUnknownAtRules": "off"
            },
            "nursery": {
                "useSortedClasses": "error"
            }
        },
        "domains": {
            "react": "recommended"
        }
    },
    "assist": {
        "actions": {
            "source": {
                "organizeImports": "on"
            }
        }
    }
}
